# Shelby api-pwa — Environment Variables
# Set these in Railway Dashboard → Service → Variables

NODE_ENV=production
PORT=3000

# Your Supabase connection pooler URL (same as main api)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=https://shelby-pwa.vercel.app
